# ============================================================
# Jarvis — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# ============================================================

# LLM backend
# Swap LLM_BASE_URL to change provider. No code changes needed.
# Groq: https://api.groq.com/openai/v1
# Ollama (local): http://localhost:11434/v1
# Homelab (via Tailscale): http://100.x.x.x:11434/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Voice mode
# Set to false on Windows (sidecars don't run on Windows).
# Set to true on Framework 13 / Optiplex for full voice loop.
VOICE_MODE=false

# TTS sidecar (Kokoro)
TTS_URL=http://localhost:5001

# STT sidecar (faster-whisper)
STT_URL=http://localhost:5002
STT_MODEL=base.en

# Memory
# Qdrant holds episode embeddings; it is an INDEX, not the source of truth.
# SQLite is, so the collection can be rebuilt at any time:
#   npx tsx dev/scripts/rebuild-episode-index.ts
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ixa_episodes
OLLAMA_URL=http://localhost:11434
OBSIDIAN_VAULT_PATH=

# Embeddings (episodic memory)
# The model name is recorded on each episode, so changing it means rebuilding
# the collection. Keep-alive stops Ollama unloading the model between turns.
IXA_EMBED_MODEL=nomic-embed-text
IXA_EMBED_KEEP_ALIVE=1h

# Episodic recall
# Once per user turn, before the first LLM call, Ixa embeds the message and
# pulls the top K past episodes above the similarity threshold. If the whole
# step takes longer than the timeout it is skipped for that turn — memory must
# never make a voice reply slow. The threshold was measured with
# nomic-embed-text: related questions score ~0.65-0.74, unrelated ones ~0.54.
IXA_RECALL_TOP_K=3
IXA_RECALL_MIN_SCORE=0.60
IXA_RECALL_TIMEOUT_MS=300
IXA_RECALL_MAX_CHARS=1500

# Episode writing
# A session is summarized when it ends, unless it had fewer than this many user
# turns. Episodes that cannot be embedded (Qdrant or Ollama down) are saved
# anyway and indexed later, retried on this interval.
IXA_EPISODE_MIN_USER_TURNS=2
IXA_EPISODE_SUMMARY_INPUT_CHARS=12000
IXA_EPISODE_INDEX_RETRY_MS=300000

# How many episodes the search_memory tool returns
IXA_MEMORY_SEARCH_LIMIT=5

# Home Assistant
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# OctoPrint
OCTOPRINT_URL=http://octopi.local
OCTOPRINT_KEY=

# Notifications
NTFY_URL=http://localhost:2586
NTFY_TOPIC=jarvis

# Web search — use one or the other
TAVILY_API_KEY=your_tavily_key        # dev: free tier, no card
SEARXNG_URL=http://localhost:8080     # prod: self-hosted Docker

# Google OAuth (generated by googleapis auth flow)
# Tokens are managed by keytar (OS keychain) — not stored here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server
PORT=3000
WS_PORT=3001

# Sessions
# Sessions live on the backend and outlive client connections, so a reconnect
# keeps the conversation. A session ends only after this long with no turns
# (the clock runs from the last completed turn), or on an explicit reset.
IXA_SESSION_IDLE_TIMEOUT_MS=1800000

# Context window sent to the LLM. Stored history is never trimmed; these cap
# only what each request carries. Character count is a deliberate approximation
# of token count — no tokenizer dependency. A tool call and its result are
# always sent together or not at all.
IXA_CONTEXT_MAX_MESSAGES=40
IXA_CONTEXT_BUDGET_CHARS=24000

# Local storage
# One SQLite file holds the preference store and persisted sessions. Defaults
# to data/ixa.db inside the repo, which is gitignored. The directory is created
# on first run.
IXA_DB_PATH=

# Preference injection
# Active preferences are rebuilt into the system context on every LLM call, so
# an update applies immediately and windowing can never drop them. These cap
# how much of the store one request can carry; a truncating cap logs a warning.
IXA_PREFS_MAX_INJECTED=40
IXA_PREFS_MAX_CHARS=2000
